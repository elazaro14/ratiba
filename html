<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Official School Timetable 2026</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#2c3e50">
    
    <style>
        :root { --row-height: 45px; --font-size: 11px; --cell-padding: 5px; }
        .compact-mode { --row-height: 32px; --font-size: 9.5px; --cell-padding: 2px; }

        body { font-family: Arial, sans-serif; background: #f8f9fa; margin: 0; padding: 10px; }
        .container { max-width: 1450px; margin: 0 auto; }
        .panel { background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 15px; }
        
        .print-header { display: flex; align-items: center; justify-content: center; gap: 20px; margin-bottom: 10px; }
        .school-logo { max-height: 80px; max-width: 80px; display: none; object-fit: contain; }
        .header-text { text-align: center; }
        .header-text h1 { margin: 0; font-size: 22px; text-transform: uppercase; }
        .header-text h2 { margin: 5px 0; font-size: 16px; font-weight: normal; }

        .school-info-inputs { display: flex; justify-content: center; gap: 15px; margin-bottom: 15px; align-items: center; flex-wrap: wrap; }
        .school-info-inputs input[type="text"] { border: none; border-bottom: 2px solid #2c3e50; font-weight: bold; font-size: 16px; text-align: center; padding: 5px; outline: none; background: transparent; }
        
        table { width: 100%; border-collapse: collapse; background: white; table-layout: fixed; margin-bottom: 25px; }
        th, td { border: 1px solid #444; padding: var(--cell-padding); text-align: center; font-size: var(--font-size); height: var(--row-height); overflow: hidden; }
        th { background: #2c3e50; color: white; }
        
        .time-hdr { font-size: 0.85em; font-weight: normal; display: block; }
        .day-title { background: #34495e; color: white; padding: 8px; font-size: 16px; text-align: center; margin: 15px 0 5px; border-radius: 4px; }
        
        .break-cell { background: #f1f3f5; font-weight: bold; color: #777; width: 25px !important; font-size: 8px; writing-mode: vertical-rl; text-orientation: mixed; }
        .fixed-block { background: #d1ecf1; color: #0c5460; font-weight: bold; font-style: italic; }
        .mosque-strips { background: repeating-linear-gradient(45deg, #fff9c4, #fff9c4 10px, #fffde7 10px, #fffde7 20px); }

        .unavailable-block { background: #ffcdd2; color: #b71c1c; font-weight: bold; font-size: 9px; }
        .separator { background: #ffd700 !important; height: 3px !important; line-height: 3px; }
        .separator td { height: 3px !important; padding: 0; border: none; }
        
        .load-table { table-layout: auto !important; max-width: 800px; margin: 20px auto; }
        .load-table th, .load-table td { height: auto !important; padding: 8px; }
        .overload { color: #d9534f; font-weight: bold; background: #fff5f5; }

        .controls { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; align-items: center; }
        .settings-bar { margin-top: 10px; padding: 10px; border-top: 1px solid #eee; display: flex; justify-content: center; gap: 20px; font-size: 12px; font-weight: bold; }
        .view-bar { background: #e9ecef; padding: 12px; border-radius: 6px; display: none; margin-top: 10px; text-align: center; }
        
        .avail-panel, .config-panel { background: #fdfdfe; border: 1px dashed #ccc; padding: 12px; margin-top: 10px; border-radius: 4px; }
        .config-row { display: flex; flex-wrap: wrap; gap: 15px; margin-bottom: 10px; align-items: center; font-size: 12px; }
        .config-group { display: flex; align-items: center; gap: 5px; }
        .config-group input, .config-group select { padding: 4px 6px; font-size: 12px; }
        
        button, select { padding: 8px 12px; border-radius: 4px; border: 1px solid #ccc; cursor: pointer; font-weight: bold; font-size: 12px; }
        .btn-gen { background: #28a745; color: white; border: none; }

        /* Lockscreen Styles */
        .lock-container { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #ffffff; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 999999; font-family: Arial, sans-serif; text-align: center; }
        .lock-container h1 { color: #d9534f; font-size: 32px; margin-bottom: 15px; font-weight: bold; }
        .lock-container p { font-size: 22px; color: #2c3e50; font-weight: bold; }

        /* Responsive Mobile Layout CSS Rules */
        @media screen and (max-width: 768px) {
            body { padding: 5px; }
            .school-info-inputs input[type="text"] { width: 100% !important; margin-bottom: 5px; }
            .controls, .settings-bar { flex-direction: column; align-items: stretch; gap: 10px; }
            button, select { width: 100%; box-sizing: border-box; text-align: center; }
            .config-row { flex-direction: column; align-items: stretch; gap: 12px; }
            .config-group { justify-content: space-between; border-left: none !important; padding-left: 0 !important; }
            .day-section { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-bottom: 15px; }
            table { table-layout: auto; min-width: 700px; }
            th, td { font-size: 10px; padding: 4px; }
            .break-cell { width: auto !important; writing-mode: horizontal-tb; text-orientation: mixed; height: auto !important; }
        }

        @media print { 
            @page { margin: 0.8cm; } 
            .panel, .view-bar, .settings-bar, #status, .school-info-inputs, .avail-panel, .config-panel { display: none !important; } 
            body { background: white; padding: 0; margin: 0; }
            .container { max-width: 100%; margin: 0; }
            .day-section { page-break-after: always; }
            .school-logo { display: block !important; }
            .mosque-strips { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body id="mainBody">

<div id="wholeAppWrapper">
    <div class="panel container">
        <div class="school-info-inputs">
            <input type="file" id="logoUpload" accept="image/*" hidden onchange="loadLogo(event)">
            <button onclick="document.getElementById('logoUpload').click()" style="background:#6c757d; color:white;">Add Logo</button>
            <input type="text" id="schoolNameInput" placeholder="ENTER SCHOOL NAME" style="width: 350px;" oninput="syncHeader(); saveToLocalStorage();">
            <input type="text" id="academicYearInput" placeholder="ACADEMIC YEAR" style="width: 200px;" oninput="syncHeader(); saveToLocalStorage();">
        </div>

        <div class="controls">
            <input type="file" id="csvFile" accept=".csv" hidden onchange="handleUpload(event)">
            <button class="btn-up" onclick="document.getElementById('csvFile').click()" style="background:#007bff; color:white; border:none;">Upload CSV</button>
            <button onclick="togglePanel('configPanel')" style="background:#ffc107; color:black; border:none;">Configure Timeline & Blocks</button>
            <button onclick="togglePanel('availPanel')" style="background:#17a2b8; color:white; border:none;">Set Teacher Off-Times</button>
            <button class="btn-gen" id="genBtn" onclick="startGeneration()" disabled>Generate Timetable</button>
            <button onclick="clearSystemBackup()" style="background:#dc3545; color:white; border:none;">Reset System Data</button>
            <button onclick="window.print()">Print</button>
        </div>

        <div id="configPanel" class="config-panel" style="display: none;">
            <h4 style="margin-top:0; color:#2c3e50;">1. Timeline Configurations</h4>
            <div class="config-row">
                <div class="config-group">
                    <label>Start Time:</label>
                    <input type="time" id="cfgStartTime" value="08:00" onchange="recalculatePeriods(); saveToLocalStorage();">
                </div>
                <div class="config-group">
                    <label>Period Duration:</label>
                    <input type="number" id="cfgPeriodDuration" value="40" style="width:50px;" onchange="recalculatePeriods(); saveToLocalStorage();"> mins
                </div>
                
                <div class="config-group" style="border-left: 2px solid #ccc; padding-left: 15px;">
                    <label>Break Label:</label>
                    <input type="text" id="cfgBreakLabel" value="TEA BREAK" style="width:90px;" onchange="recalculatePeriods(); saveToLocalStorage();">
                </div>
                <div class="config-group">
                    <label>After Period:</label>
                    <select id="cfgBreakAfter" onchange="recalculatePeriods(); saveToLocalStorage();">
                        <option value="P1">P1</option>
                        <option value="P2">P2</option>
                        <option value="P3">P3</option>
                        <option value="P4" selected>P4</option>
                        <option value="P5">P5</option>
                        <option value="P6">P6</option>
                        <option value="P7">P7</option>
                        <option value="P8">P8</option>
                    </select>
                </div>
                <div class="config-group">
                    <label>Break Duration:</label>
                    <input type="number" id="cfgBreakDuration" value="30" style="width:50px;" onchange="recalculatePeriods(); saveToLocalStorage();"> mins
                </div>
            </div>

            <div class="config-row" style="margin-top: 10px;">
                <div class="config-group">
                    <label>Include Lunch Break?</label>
                    <select id="cfgHasLunch" onchange="recalculatePeriods(); saveToLocalStorage();">
                        <option value="yes" selected>Yes</option>
                        <option value="no">No</option>
                    </select>
                </div>
                <div class="config-group" style="border-left: 2px solid #ccc; padding-left: 15px;">
                    <label>Lunch Label:</label>
                    <input type="text" id="cfgLunchLabel" value="LUNCH BREAK" style="width:90px;" onchange="recalculatePeriods(); saveToLocalStorage();">
                </div>
                <div class="config-group">
                    <label>After Period:</label>
                    <select id="cfgLunchAfter" onchange="recalculatePeriods(); saveToLocalStorage();">
                        <option value="P1">P1</option>
                        <option value="P2">P2</option>
                        <option value="P3">P3</option>
                        <option value="P4">P4</option>
                        <option value="P5">P5</option>
                        <option value="P6" selected>P6</option>
                        <option value="P7">P7</option>
                        <option value="P8">P8</option>
                    </select>
                </div>
                <div class="config-group">
                    <label>Lunch Duration:</label>
                    <input type="number" id="cfgLunchDuration" value="45" style="width:50px;" onchange="recalculatePeriods(); saveToLocalStorage();"> mins
                </div>
            </div>

            <h4 style="margin-top:15px; margin-bottom:5px; color:#2c3e50;">2. Custom Special Fixed Blocks</h4>
            <div class="config-row">
                <div class="config-group">
                    <label>Day:</label>
                    <select id="spDay">
                        <option value="MONDAY">MONDAY</option>
                        <option value="TUESDAY">TUESDAY</option>
                        <option value="WEDNESDAY">WEDNESDAY</option>
                        <option value="THURSDAY">THURSDAY</option>
                        <option value="FRIDAY">FRIDAY</option>
                    </select>
                </div>
                <div class="config-group">
                    <label>From:</label>
                    <select id="spStart"></select>
                </div>
                <div class="config-group">
                    <label>To:</label>
                    <select id="spEnd"></select>
                </div>
                <div class="config-group">
                    <label>Label Text:</label>
                    <input type="text" id="spLabel" placeholder="e.g. DEBATE" style="width:100px;">
                </div>
                <div class="config-group">
                    <label>Style Template:</label>
                    <select id="spStyle">
                        <option value="fixed-block">Religion / Debate Style (Cyan)</option>
                        <option value="mosque-strips">Mosque Style (Yellow Pattern)</option>
                    </select>
                </div>
                <button onclick="addSpecialBlock()" style="padding:4px 10px; background:#28a745; color:white; border:none;">Add Fixed Block</button>
            </div>
            <div id="specialBlocksList" style="margin-top:10px; font-size:11px; gap:5px; flex-wrap:wrap; display:flex;"></div>
        </div>

        <div id="availPanel" class="avail-panel" style="display: none;">
            <h4 style="margin-top:0">Teacher Unavailability (Off-Times)</h4>
            <select id="availTeacher"></select>
            <select id="availDay"></select>
            <select id="availPeriod"></select>
            <button onclick="addUnavailability()">Add Rule</button>
            <div id="availList" style="margin-top:10px; font-size:11px; gap:5px; flex-wrap:wrap; display:flex;"></div>
        </div>

        <div class="settings-bar">
            <label><input type="checkbox" id="compactModeCheck" onchange="toggleCompact(this); saveToLocalStorage();"> Compact Mode</label> |
            <label>Display: 
                <select id="displayType" onchange="syncHeader(); saveToLocalStorage();">
                    <option value="both">Subject & Teacher</option>
                    <option value="subOnly">Subject Only</option>
                </select>
            </label> |
            <label>Row Height: <input type="range" id="rowHeightRange" min="30" max="60" value="45" oninput="adjustHeight(this.value)" onchange="saveToLocalStorage();"></label>
        </div>
        
        <div id="status" style="text-align:center; margin-top:10px; font-weight:bold; color:#d9534f; font-size: 12px;">Waiting for CSV...</div>
        
        <div class="view-bar" id="viewBar">
            <button onclick="renderMaster()">Full School View</button>
            <select id="streamSelect" onchange="renderIndividual('stream')"><option value="">-- View Class --</option></select>
            <select id="teacherSelect" onchange="renderIndividual('teacher')"><option value="">-- View Teacher --</option></select>
            <button onclick="renderLoadSummary()" style="background:#6f42c1; color:white; border:none;">Load Summary</button>
        </div>
    </div>

    <div id="output" class="container"></div>
</div>

<script>
// Expiry System Verification Execution Code
function checkSystemValidity() {
    const expirationThreshold = new Date("2026-06-30T23:59:59");
    const rightNow = new Date();
    if (rightNow > expirationThreshold) {
        document.getElementById("wholeAppWrapper").innerHTML = `
            <div class="lock-container">
                <h1>TIMETABLE SYSTEM EXPIRED</h1>
                <p>ALERT: CONTACT DEVELOPER 0763418732</p>
            </div>
        `;
        alert("ALERT: CONTACT DEVELOPER 0763418732");
        return true;
    }
    return false;
}

const DAYS = ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"];
const FORMS = ["F1A","F1B","F1C","F2A","F2B","F2C","F2D","F3A","F3B","F3C","F4A","F4B"];

let PERIODS = [];
let rawData = [], timetable = [], logoSrc = "", unavailabilities = [];

let customSpecialBlocks = [
    { day: "WEDNESDAY", start: "P8", end: "P9", text: "RELIGION", class: "fixed-block" },
    { day: "FRIDAY", start: "P7", end: "P9", text: "", class: "mosque-strips" }
];

function togglePanel(id) {
    if (checkSystemValidity()) return;
    const p = document.getElementById(id);
    p.style.display = p.style.display === 'block' ? 'none' : 'block';
}

function toggleAvailPanel() { togglePanel('availPanel'); }

function loadLogo(e) {
    const reader = new FileReader();
    reader.onload = (event) => { logoSrc = event.target.result; syncHeader(); saveToLocalStorage(); };
    reader.readAsDataURL(e.target.files[0]);
}

function toggleCompact(cb) { document.getElementById('mainBody').classList.toggle('compact-mode', cb.checked); }
function adjustHeight(val) { document.documentElement.style.setProperty('--row-height', val + 'px'); }

function recalculatePeriods() {
    const startTimeStr = document.getElementById('cfgStartTime').value;
    const periodDuration = parseInt(document.getElementById('cfgPeriodDuration').value) || 40;
    
    const breakLabel = document.getElementById('cfgBreakLabel').value || "TEA BREAK";
    const breakAfter = document.getElementById('cfgBreakAfter').value;
    const breakDuration = parseInt(document.getElementById('cfgBreakDuration').value) || 30;

    const hasLunch = document.getElementById('cfgHasLunch').value === "yes";
    const lunchLabel = document.getElementById('cfgLunchLabel').value || "LUNCH BREAK";
    const lunchAfter = document.getElementById('cfgLunchAfter').value;
    const lunchDuration = parseInt(document.getElementById('cfgLunchDuration').value) || 45;

    let [hours, minutes] = startTimeStr.split(':').map(Number);
    let currentTotalMinutes = hours * 60 + minutes;

    function formatTimeRange(startMins, durationMins) {
        let sh = Math.floor(startMins / 60);
        let sm = startMins % 60;
        let eh = Math.floor((startMins + durationMins) / 60);
        let em = (startMins + durationMins) % 60;
        return `${sh}:${sm.toString().padStart(2,'0')}-${eh}:${em.toString().padStart(2,'0')}`;
    }

    PERIODS = [];
    const basePList = ["P1","P2","P3","P4","P5","P6","P7","P8","P9"];

    basePList.forEach(pName => {
        let pRange = formatTimeRange(currentTotalMinutes, periodDuration);
        PERIODS.push({ p: pName, t: pRange, rawStart: currentTotalMinutes, rawEnd: currentTotalMinutes + periodDuration });
        currentTotalMinutes += periodDuration;

        if (pName === breakAfter) {
            let bRange = formatTimeRange(currentTotalMinutes, breakDuration);
            PERIODS.push({ p: "BREAK", t: bRange, label: breakLabel });
            currentTotalMinutes += breakDuration;
        }

        if (hasLunch && pName === lunchAfter) {
            let luRange = formatTimeRange(currentTotalMinutes, lunchDuration);
            PERIODS.push({ p: "LUNCH", t: luRange, label: lunchLabel });
            currentTotalMinutes += lunchDuration;
        }
    });

    const nonBreakList = PERIODS.filter(x => x.p !== "BREAK" && x.p !== "LUNCH").map(x => x.p);
    document.getElementById('spStart').innerHTML = nonBreakList.map(p => `<option value="${p}">${p}</option>`).join('');
    document.getElementById('spEnd').innerHTML = nonBreakList.map(p => `<option value="${p}">${p}</option>`).join('');
    
    populateAvailDropdowns();
    if(timetable.length > 0) syncHeader();
}

function getSpecialContent(day, p) {
    if (p === "BREAK" || p === "LUNCH") return null;
    
    const targetIdx = PERIODS.filter(x => x.p !== "BREAK" && x.p !== "LUNCH").findIndex(x => x.p === p);
    if(targetIdx === -1) return null;

    for (let rule of customSpecialBlocks) {
        if (rule.day === day) {
            const startIdx = PERIODS.filter(x => x.p !== "BREAK" && x.p !== "LUNCH").findIndex(x => x.p === rule.start);
            const endIdx = PERIODS.filter(x => x.p !== "BREAK" && x.p !== "LUNCH").findIndex(x => x.p === rule.end);
            if (targetIdx >= startIdx && targetIdx <= endIdx) {
                return rule;
            }
        }
    }
    return null;
}

// Global programmatic stubs for complete engine compliance
function populateAvailDropdowns() {}
function handleUpload(e) {}
function startGeneration() {}
function clearSystemBackup() {}
function renderMaster() {}
function renderIndividual(type) {}
function renderLoadSummary() {}
function addSpecialBlock() {}
function addUnavailability() {}
function saveToLocalStorage() {}
function syncHeader() {}

// Initial configurations load
recalculatePeriods();
</script>

<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('./service-worker.js')
        .then(reg => console.log('TT-PRO Core Engine PWA Registered!', reg))
        .catch(err => console.error('PWA Engine Registry Halted:', err));
    });
  }
</script>
</body>
</html>
